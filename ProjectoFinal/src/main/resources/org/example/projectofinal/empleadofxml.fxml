<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.projectofinal.controller.EmpleadoFormController"
      spacing="12"
      prefWidth="430"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label fx:id="lblTitulo"
           text="Registrar empleado"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Nombre completo"/>
    <TextField fx:id="txtNombre"
               promptText="Nombre y apellidos"/>

    <Label text="CIF"/>
    <TextField fx:id="txtCif"
               promptText="Identificación del empleado"/>

    <Label text="Correo institucional"/>
    <TextField fx:id="txtCorreo"
               promptText="correo@institucion.edu"/>

    <Label text="Categoría de personal"/>
    <ComboBox fx:id="cmbCategoria"
              promptText="Seleccione una categoría"
              maxWidth="Infinity"/>

    <Label text="Departamento"/>
    <ComboBox fx:id="cmbDepartamento"
              promptText="Seleccione un departamento"
              maxWidth="Infinity"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancelar"
                onAction="#cancelar"/>

        <Button fx:id="btnGuardar"
                text="Guardar"
                onAction="#guardar"
                style="-fx-background-color: #3478B8; -fx-text-fill: white;"/>
    </HBox>

</VBox>

