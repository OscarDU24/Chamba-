<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projectofinal.controller.AdminPanelController"
            prefWidth="1000"
            prefHeight="600"
            style="-fx-background-color: #F4F6F9;">

    <top>
        <VBox spacing="5" style="-fx-background-color: #E8EDF2;">
            <padding>
                <Insets top="18" right="20" bottom="18" left="20"/>
            </padding>

            <Label text="Gestión de empleados"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Registro y administración de los datos del personal."
                   style="-fx-text-fill: #555555;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar por nombre, CIF o correo..."
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="cmbDepartamento"
                          promptText="Departamento"
                          prefWidth="180"/>

                <Button text="Actualizar"
                        onAction="#actualizarTabla"/>
            </HBox>

            <TableView fx:id="tablaEmpleados"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colNombre"
                                 text="Nombre completo"
                                 prefWidth="190"/>

                    <TableColumn fx:id="colCif"
                                 text="CIF"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colCorreo"
                                 text="Correo institucional"
                                 prefWidth="190"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colDepartamento"
                                 text="Departamento"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colEstadoCuenta"
                                 text="Estado de cuenta"
                                 prefWidth="120"/>
                </columns>

                <placeholder>
                    <Label text="No hay empleados registrados."/>
                </placeholder>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Registrar"
                        onAction="#registrarEmpleado"/>

                <Button text="Editar"
                        onAction="#editarEmpleado"/>

                <Button text="Eliminar"
                        onAction="#eliminarEmpleado"/>

                <Button text="Activar / Desactivar cuenta"
                        onAction="#cambiarEstadoCuenta"/>
            </HBox>

            <Label fx:id="lblEstado"
                   text="Seleccione un empleado para realizar una operación."
                   style="-fx-text-fill: #555555;"/>
        </VBox>
    </center>

</BorderPane>



