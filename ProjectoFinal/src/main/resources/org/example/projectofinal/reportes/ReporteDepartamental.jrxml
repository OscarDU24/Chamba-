			</box>
			<element kind="staticText" x="12" y="10" width="110" height="24" style="Etiqueta">
				<text><![CDATA[Objetivos asignados]]></text>
			</element>
			<element kind="textField" x="12" y="30" width="110" height="24" style="Cifra">
				<expression><![CDATA[String.valueOf($F{total_objetivos})]]></expression>
			</element>
			<element kind="staticText" x="132" y="10" width="120" height="24" style="Etiqueta" forecolor="#315DA8">
				<text><![CDATA[AVANCE DEPARTAMENTAL]]></text>
			</element>
			<element kind="textField" x="132" y="30" width="120" height="24" style="Cifra" forecolor="#315DA8">
				<expression><![CDATA[$F{avance_departamental} == null ? "—" : $F{avance_departamental}.stripTrailingZeros().toPlainString() + " %"]]></expression>
			</element>
			<element kind="staticText" x="262" y="10" width="130" height="24" style="Etiqueta">
				<text><![CDATA[Evaluación departamental]]></text>
			</element>
			<element kind="textField" x="262" y="30" width="130" height="24" style="Cifra">
				<expression><![CDATA[$F{evaluacion_departamental} == null ? "Sin evaluar" : $F{evaluacion_departamental}.stripTrailingZeros().toPlainString()]]></expression>
			</element>
			<element kind="textField" x="262" y="54" width="130" height="14" style="Etiqueta" blankWhenNull="true">
				<expression><![CDATA[$F{estado_evaluacion_departamental} == null ? null : $F{estado_evaluacion_departamental}.replace("_", " ")]]></expression>
			</element>
			<element kind="staticText" x="402" y="10" width="90" height="24" style="Etiqueta">
				<text><![CDATA[Empleados activos]]></text>
			</element>
			<element kind="textField" x="402" y="30" width="90" height="24" style="Cifra">
				<expression><![CDATA[String.valueOf($F{empleados_activos})]]></expression>
			</element>
			<element kind="staticText" x="502" y="10" width="95" height="24" style="Etiqueta">
				<text><![CDATA[Evaluaciones individuales finalizadas]]></text>
			</element>
			<element kind="textField" x="502" y="30" width="95" height="24" style="Cifra">
				<expression><![CDATA[String.valueOf($F{evaluaciones_finalizadas})]]></expression>
			</element>
			<element kind="staticText" x="607" y="10" width="80" height="24" style="Etiqueta">
				<text><![CDATA[Pendientes de evaluar]]></text>
			</element>
			<element kind="textField" x="607" y="30" width="80" height="24" style="Cifra">
				<expression><![CDATA[String.valueOf($F{evaluaciones_pendientes})]]></expression>
			</element>
			<element kind="staticText" x="697" y="10" width="95" height="24" style="Etiqueta">
				<text><![CDATA[Promedio final individual]]></text>
			</element>
			<element kind="textField" x="697" y="30" width="95" height="24" style="Cifra">
				<expression><![CDATA[$F{promedio_final_individual} == null ? "—" : $F{promedio_final_individual}.stripTrailingZeros().toPlainString()]]></expression>
			</element>
			<element kind="staticText" x="697" y="54" width="95" height="14" style="Etiqueta">
				<text><![CDATA[solo finalizadas]]></text>
			</element>
		</element>
	</summary>
