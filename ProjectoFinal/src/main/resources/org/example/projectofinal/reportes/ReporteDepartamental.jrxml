		</element>
	</pageFooter>
	<summary height="110">
		<element kind="staticText" x="0" y="14" width="802" height="12" style="Etiqueta">
			<text><![CDATA[RESUMEN DEL DEPARTAMENTO EN EL PERÍODO]]></text>
		</element>
		<element kind="frame" x="0" y="28" width="802" height="76" mode="Opaque" backcolor="#F4F6FA">
