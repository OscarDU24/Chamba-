			</element>
			<element kind="textField" x="215" y="0" width="70" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center">
				<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[String.valueOf($F{empleados})]]></expression>
			</element>
			<element kind="textField" x="285" y="0" width="75" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center">
				<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[String.valueOf($F{objetivos})]]></expression>
			</element>
			<element kind="textField" x="360" y="0" width="80" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center" bold="true" forecolor="#315DA8">
				<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{avance} == null ? "Sin objetivos" : $F{avance}.stripTrailingZeros().toPlainString() + " %"]]></expression>
			</element>
			<element kind="textField" x="440" y="0" width="55" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center" bold="true">
				<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{evaluacion_final} == null ? "—" : $F{evaluacion_final}.stripTrailingZeros().toPlainString()]]></expression>
			</element>
			<element kind="textField" x="495" y="0" width="60" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center">
				<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{estado} == null ? "Sin evaluar" : $F{estado}.replace("_", " ")]]></expression>
			</element>
			<element kind="textField" x="0" y="0" width="165" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Left" bold="true">
				<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{nombre}]]></expression>
			</element>
			<element kind="textField" x="165" y="0" width="155" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Left">
				<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{departamento}]]></expression>
			</element>
			<element kind="textField" x="320" y="0" width="55" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center">
				<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[String.valueOf($F{objetivos})]]></expression>
			</element>
			<element kind="textField" x="375" y="0" width="70" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center" bold="true" forecolor="#315DA8">
				<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{avance} == null ? "Sin objetivos" : $F{avance}.stripTrailingZeros().toPlainString() + " %"]]></expression>
			</element>
			<element kind="textField" x="445" y="0" width="50" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center" bold="true">
				<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{evaluacion_final} == null ? "—" : $F{evaluacion_final}.stripTrailingZeros().toPlainString()]]></expression>
			</element>
			<element kind="textField" x="495" y="0" width="60" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Center">
				<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
					<bottomPen lineWidth="0.5" lineColor="#DCE3EE"/>
				</box>
				<expression><![CDATA[$F{estado} == null ? "Sin evaluar" : $F{estado}.replace("_", " ")]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="24">
		<element kind="line" x="0" y="4" width="555" height="1" forecolor="#DCE3EE"/>
		<element kind="textField" x="0" y="8" width="380" height="14" style="Etiqueta">
			<expression><![CDATA["Reportes de desempeño · " + $F{periodo}]]></expression>
		</element>
		<element kind="textField" x="380" y="8" width="140" height="14" style="Etiqueta" hTextAlign="Right">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></expression>
		</element>
		<element kind="textField" x="520" y="8" width="35" height="14" style="Etiqueta" evaluationTime="Report">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<summary height="40">
		<element kind="staticText" x="0" y="6" width="555" height="32" style="Etiqueta">
			<text><![CDATA[Avance: promedio del último avance registrado en cada objetivo del período; un objetivo sin avance cuenta como 0. Los promedios de las tarjetas no incluyen departamentos ni empleados "Sin objetivos". Final: puntuación final de la evaluación guardada.]]></text>
		</element>
	</summary>
	<noData height="70">
		<element kind="frame" x="0" y="0" width="555" height="44" mode="Opaque" backcolor="#202C3B">
			<element kind="staticText" x="16" y="10" width="520" height="24" style="Base" fontSize="15.0" bold="true" forecolor="#FFFFFF">
				<text><![CDATA[Reportes de desempeño]]></text>
			</element>
		</element>
		<element kind="textField" x="0" y="52" width="555" height="16" style="Base" fontSize="10.0" forecolor="#B42318">
			<expression><![CDATA["No se encontró el período \"" + $P{P_PERIODO} + "\". Revise el parámetro P_PERIODO."]]></expression>
		</element>
	</noData>
</jasperReport>
