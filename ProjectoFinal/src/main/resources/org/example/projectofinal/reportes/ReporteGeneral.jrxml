<!-- Reporte general de desempeño: equivalente a la pantalla Reportes del sistema (JasperReports 7) -->
<jasperReport name="ReporteGeneral" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="3c0f6a4e-1b2d-4f6a-9c11-0a1b2c3d4e00">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sistema_atencion"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<style name="Base" default="true" fontName="SansSerif" fontSize="8.5" forecolor="#1D2B45"/>
	<style name="Etiqueta" style="Base" fontSize="7.5" forecolor="#5F6E85"/>
	<style name="Encabezado" style="Base" fontSize="8.0" bold="true" forecolor="#FFFFFF" backcolor="#315DA8" mode="Opaque" vTextAlign="Middle"/>
	<parameter name="P_PERIODO" class="java.lang.String">
		<description><![CDATA[Nombre del período de evaluación]]></description>
		<defaultValueExpression><![CDATA["Segundo semestre 2026"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[WITH p AS (
    SELECT * FROM periodos_evaluacion WHERE nombre = $P{P_PERIODO}
),
asig AS (
    SELECT a.id_asignacion, a.id_departamento,
           COALESCE((SELECT s.porcentaje_avance FROM seguimientos s
                      WHERE s.id_asignacion = a.id_asignacion AND s.tipo = 'DEPARTAMENTAL'
                      ORDER BY s.fecha_seguimiento DESC LIMIT 1), 0) AS avance
    FROM objetivos_departamento a JOIN p ON p.id_periodo = a.id_periodo
),
dep AS (
    SELECT d.nombre,
           (SELECT count(*) FROM empleados e WHERE e.id_departamento = d.id_departamento AND e.activo) AS empleados,
           (SELECT count(*) FROM asig WHERE asig.id_departamento = d.id_departamento) AS objetivos,
           (SELECT round(avg(asig.avance), 2) FROM asig WHERE asig.id_departamento = d.id_departamento) AS avance,
           ev.puntuacion_final AS evaluacion_final,
           ev.estado
    FROM departamentos d
    CROSS JOIN p
    LEFT JOIN evaluaciones ev ON ev.id_periodo = p.id_periodo AND ev.tipo = 'DEPARTAMENTAL'
                             AND ev.id_departamento = d.id_departamento
    WHERE d.activo
),
emp_obj AS (
    SELECT r.id_empleado,
           COALESCE((SELECT s.porcentaje_avance FROM seguimientos s
                      WHERE s.id_asignacion = a.id_asignacion AND s.tipo = 'INDIVIDUAL'
                        AND s.id_empleado = r.id_empleado
                      ORDER BY s.fecha_seguimiento DESC LIMIT 1), 0) AS avance
    FROM responsables_objetivos r
    JOIN asig a ON a.id_asignacion = r.id_asignacion
),
emp AS (
    SELECT e.nombre_completo AS nombre,
           COALESCE(d.nombre, 'Sin departamento') AS departamento,
           (SELECT count(*) FROM emp_obj o WHERE o.id_empleado = e.id_empleado) AS objetivos,
           (SELECT round(avg(o.avance), 2) FROM emp_obj o WHERE o.id_empleado = e.id_empleado) AS avance,
           ev.puntuacion_final AS evaluacion_final,
           ev.estado
    FROM empleados e
    CROSS JOIN p
    LEFT JOIN departamentos d ON d.id_departamento = e.id_departamento
    LEFT JOIN evaluaciones ev ON ev.id_periodo = p.id_periodo AND ev.tipo = 'INDIVIDUAL'
                             AND ev.id_empleado = e.id_empleado
    WHERE e.activo
),
tarjetas AS (
    SELECT (SELECT round(avg(avance), 2) FROM dep) AS avance_promedio_departamental,
           (SELECT round(avg(avance), 2) FROM emp) AS avance_promedio_individual,
           (SELECT count(*) FROM emp WHERE evaluacion_final IS NOT NULL) AS empleados_evaluados,
           (SELECT count(*) FROM emp) AS empleados_total
)
SELECT p.nombre AS periodo, p.fecha_inicio, p.fecha_fin, p.estado AS estado_periodo,
       t.avance_promedio_departamental, t.avance_promedio_individual,
       t.empleados_evaluados, t.empleados_total,
       x.seccion, x.nombre, x.departamento, x.empleados, x.objetivos, x.avance,
       x.evaluacion_final, x.estado
FROM p
CROSS JOIN tarjetas t
CROSS JOIN (
    SELECT 1 AS seccion, nombre, NULL::varchar AS departamento, empleados, objetivos, avance,
           evaluacion_final, estado FROM dep
    UNION ALL
    SELECT 2, nombre, departamento, NULL::bigint, objetivos, avance, evaluacion_final, estado FROM emp
) x
ORDER BY x.seccion, x.nombre]]></query>
	<field name="periodo" class="java.lang.String"/>
	<field name="fecha_inicio" class="java.sql.Date"/>
	<field name="fecha_fin" class="java.sql.Date"/>
	<field name="estado_periodo" class="java.lang.String"/>
	<field name="avance_promedio_departamental" class="java.math.BigDecimal"/>
	<field name="avance_promedio_individual" class="java.math.BigDecimal"/>
	<field name="empleados_evaluados" class="java.lang.Long"/>
	<field name="empleados_total" class="java.lang.Long"/>
	<field name="seccion" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="departamento" class="java.lang.String"/>
	<field name="empleados" class="java.lang.Long"/>
	<field name="objetivos" class="java.lang.Long"/>
	<field name="avance" class="java.math.BigDecimal"/>
	<field name="evaluacion_final" class="java.math.BigDecimal"/>
	<field name="estado" class="java.lang.String"/>
	<group name="Seccion">
		<expression><![CDATA[$F{seccion}]]></expression>
		<groupHeader>
			<band height="38">
				<element kind="textField" x="0" y="4" width="555" height="16" style="Base" fontSize="10.5" bold="true">
					<expression><![CDATA[$F{seccion} == 1 ? "Por departamento" : "Por empleado"]]></expression>
				</element>
				<element kind="staticText" x="0" y="22" width="215" height="16" style="Encabezado" hTextAlign="Left">
					<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Departamento]]></text>
				</element>
				<element kind="staticText" x="215" y="22" width="70" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Empleados]]></text>
				</element>
				<element kind="staticText" x="285" y="22" width="75" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Objetivos]]></text>
				</element>
				<element kind="staticText" x="360" y="22" width="80" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Avance]]></text>
				</element>
				<element kind="staticText" x="440" y="22" width="55" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Final]]></text>
				</element>
				<element kind="staticText" x="495" y="22" width="60" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Estado]]></text>
				</element>
				<element kind="staticText" x="0" y="22" width="165" height="16" style="Encabezado" hTextAlign="Left">
					<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Empleado]]></text>
				</element>
				<element kind="staticText" x="165" y="22" width="155" height="16" style="Encabezado" hTextAlign="Left">
					<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Departamento]]></text>
				</element>
				<element kind="staticText" x="320" y="22" width="55" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Objetivos]]></text>
				</element>
				<element kind="staticText" x="375" y="22" width="70" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Avance]]></text>
				</element>
				<element kind="staticText" x="445" y="22" width="50" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Final]]></text>
				</element>
				<element kind="staticText" x="495" y="22" width="60" height="16" style="Encabezado" hTextAlign="Center">
					<printWhenExpression><![CDATA[$F{seccion} == 2]]></printWhenExpression>
					<box leftPadding="4" rightPadding="4"/>
					<text><![CDATA[Estado]]></text>
				</element>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="12"/>
		</groupFooter>
	</group>
	<title height="228">
		<element kind="frame" x="0" y="0" width="555" height="62" mode="Opaque" backcolor="#202C3B">
			<element kind="staticText" x="16" y="10" width="360" height="24" style="Base" fontSize="17.0" bold="true" forecolor="#FFFFFF">
				<text><![CDATA[Reportes de desempeño]]></text>
			</element>
			<element kind="staticText" x="16" y="36" width="360" height="16" style="Base" fontSize="9.0" forecolor="#AFC0D7">
				<text><![CDATA[Sistema de Gestión de Personal · Evaluación del desempeño]]></text>
			</element>
			<element kind="staticText" x="380" y="14" width="160" height="14" style="Base" fontSize="8.0" forecolor="#AFC0D7" hTextAlign="Right">
				<text><![CDATA[Generado el]]></text>
			</element>
			<element kind="textField" x="380" y="30" width="160" height="16" style="Base" fontSize="10.0" bold="true" forecolor="#FFFFFF" hTextAlign="Right" pattern="dd/MM/yyyy HH:mm">
				<expression><![CDATA[new java.util.Date()]]></expression>
			</element>
		</element>
		<element kind="frame" x="0" y="74" width="555" height="60" mode="Opaque" backcolor="#E6EDF9">
			<element kind="staticText" x="12" y="8" width="200" height="12" style="Etiqueta" forecolor="#315DA8">
				<text><![CDATA[PERÍODO DE EVALUACIÓN]]></text>
			</element>
			<element kind="textField" x="12" y="22" width="300" height="18" style="Base" fontSize="13.0" bold="true">
				<expression><![CDATA[$F{periodo}]]></expression>
			</element>
			<element kind="textField" x="12" y="41" width="300" height="14" style="Base" fontSize="9.0">
				<expression><![CDATA["Del " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_inicio}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_fin})]]></expression>
			</element>
			<element kind="textField" x="380" y="22" width="163" height="18" style="Base" fontSize="10.0" bold="true" forecolor="#315DA8" hTextAlign="Right">
				<expression><![CDATA[$F{estado_periodo}.replace("_", " ")]]></expression>
			</element>
		</element>
		<element kind="frame" x="0" y="146" width="179" height="72" mode="Opaque" backcolor="#F4F6FA">
			<box>
				<pen lineWidth="0.5" lineColor="#DCE3EE"/>
			</box>
			<element kind="staticText" x="10" y="8" width="160" height="12" style="Etiqueta" bold="true">
				<text><![CDATA[AVANCE PROMEDIO DEPARTAMENTAL]]></text>
			</element>
			<element kind="textField" x="10" y="22" width="160" height="28" style="Base" fontSize="22.0" bold="true" forecolor="#315DA8">
				<expression><![CDATA[$F{avance_promedio_departamental} == null ? "Sin objetivos" : $F{avance_promedio_departamental}.stripTrailingZeros().toPlainString() + " %"]]></expression>
			</element>
			<element kind="staticText" x="10" y="52" width="160" height="14" style="Etiqueta">
				<text><![CDATA[Departamentos con objetivos]]></text>
			</element>
		</element>
		<element kind="frame" x="188" y="146" width="179" height="72" mode="Opaque" backcolor="#F4F6FA">
			<box>
				<pen lineWidth="0.5" lineColor="#DCE3EE"/>
			</box>
			<element kind="staticText" x="10" y="8" width="160" height="12" style="Etiqueta" bold="true">
				<text><![CDATA[AVANCE PROMEDIO INDIVIDUAL]]></text>
			</element>
			<element kind="textField" x="10" y="22" width="160" height="28" style="Base" fontSize="22.0" bold="true" forecolor="#315DA8">
				<expression><![CDATA[$F{avance_promedio_individual} == null ? "Sin objetivos" : $F{avance_promedio_individual}.stripTrailingZeros().toPlainString() + " %"]]></expression>
			</element>
			<element kind="staticText" x="10" y="52" width="160" height="14" style="Etiqueta">
				<text><![CDATA[Empleados con objetivos]]></text>
			</element>
		</element>
		<element kind="frame" x="376" y="146" width="179" height="72" mode="Opaque" backcolor="#F4F6FA">
			<box>
				<pen lineWidth="0.5" lineColor="#DCE3EE"/>
			</box>
			<element kind="staticText" x="10" y="8" width="160" height="12" style="Etiqueta" bold="true">
				<text><![CDATA[EMPLEADOS CON EVALUACIÓN FINAL]]></text>
			</element>
			<element kind="textField" x="10" y="22" width="160" height="28" style="Base" fontSize="22.0" bold="true">
				<expression><![CDATA[$F{empleados_evaluados} + " de " + $F{empleados_total}]]></expression>
			</element>
			<element kind="staticText" x="10" y="52" width="160" height="14" style="Etiqueta">
				<text><![CDATA[Empleados activos evaluados]]></text>
			</element>
		</element>
	</title>
	<detail>
		<band height="18">
			<element kind="textField" x="0" y="0" width="215" height="18" style="Base" textAdjust="StretchHeight" vTextAlign="Middle" hTextAlign="Left">
				<printWhenExpression><![CDATA[$F{seccion} == 1]]></printWhenExpression>
				<box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4">
