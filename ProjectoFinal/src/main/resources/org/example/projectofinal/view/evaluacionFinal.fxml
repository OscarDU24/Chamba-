<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projectofinal.controller.EvaluacionFinalController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: #F4F6FA;">

    <VBox spacing="15">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

        <Label text="Evaluación final del desempeño"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label text="Modelo mixto: combina el desempeño individual y el departamental, calculados a partir de los seguimientos."
               wrapText="true" style="-fx-text-fill: #65738a;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Período:"/>
            <ComboBox fx:id="cmbPeriodo" promptText="Seleccione período" prefWidth="320"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#actualizarTodo"/>
        </HBox>

        <VBox fx:id="panelFormulario" spacing="0">
            <TitledPane text="Evaluar" expanded="true" collapsible="false">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                        <GridPane hgap="12" vgap="8">
                            <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Departamento:" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Empleado (solo INDIVIDUAL):" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <Label text="Peso individual (%):" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                            <ComboBox fx:id="cmbTipo" maxWidth="Infinity"
                                      GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cmbDepartamento" promptText="Seleccione departamento" maxWidth="Infinity"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cmbEmpleado" promptText="Seleccione empleado" maxWidth="Infinity"
                                      GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtPeso" promptText="0 a 100"
                                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                            <Label text="Puntuación individual:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label text="Puntuación departamental:" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label text="Puntuación final:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <Label text="Estado:" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                            <TextField fx:id="txtIndividual" promptText="0 a 100"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <TextField fx:id="txtDepartamental" promptText="0 a 100"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                            <TextField fx:id="txtFinal" promptText="0 a 100"
                                       style="-fx-font-weight: bold;"
                                       GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                            <ComboBox fx:id="cmbEstado" maxWidth="Infinity"
                                      GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                            <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                            <TextArea fx:id="txtObservaciones" promptText="Observaciones (opcional)"
                                      prefRowCount="2" wrapText="true"
                                      GridPane.columnIndex="0" GridPane.rowIndex="5"
                                      GridPane.columnSpan="4"/>

                            <columnConstraints>
                                <ColumnConstraints percentWidth="22" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="28" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
                            </columnConstraints>
                        </GridPane>

                        <Label fx:id="lblDetalleCalculo" wrapText="true" style="-fx-text-fill: #4263a5;"/>
                        <Label text="La ponderación entre individual y departamental aún no está definida por el equipo: se usa 50 % / 50 % y se puede cambiar arriba."
                               wrapText="true" style="-fx-text-fill: #8492A6; -fx-font-size: 11px;"/>

                        <HBox spacing="10">
                            <Button text="Calcular desde seguimientos" onAction="#calcular"/>
                            <Button text="Recalcular final" onAction="#recalcularFinalManual"/>
                            <Button text="Guardar evaluación" onAction="#guardar"/>
                            <Button text="Limpiar campos" onAction="#limpiarFormulario"/>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>
        </VBox>

        <Label text="Evaluaciones del período" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <TableView fx:id="tabla" prefHeight="320">
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
                <TableColumn fx:id="colEvaluado" text="Evaluado" prefWidth="190"/>
                <TableColumn fx:id="colDepartamento" text="Departamento" prefWidth="160"/>
                <TableColumn fx:id="colIndividual" text="Individual" prefWidth="80"/>
                <TableColumn fx:id="colDepartamental" text="Departamental" prefWidth="100"/>
                <TableColumn fx:id="colFinal" text="Final" prefWidth="70"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
                <TableColumn fx:id="colEvaluador" text="Evaluado por" prefWidth="160"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="No hay evaluaciones en este período."/></placeholder>
        </TableView>

        <Label fx:id="lblEstado" text=""/>
    </VBox>
</ScrollPane>
