<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projectofinal.controller.CategoriasController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: #F4F6FA;">

    <VBox spacing="15">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

        <Label text="Categorías de personal"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <TitledPane text="Datos de la categoría" expanded="true" collapsible="false">
            <content>
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <Label text="Nombre:"/>
                    <TextField fx:id="txtNombre" promptText="Ej. DOCENTES" maxWidth="400"/>

                    <Label text="Descripción:"/>
                    <TextArea fx:id="txtDescripcion" promptText="Descripción (opcional)"
                              prefRowCount="2" wrapText="true"/>

                    <HBox spacing="10">
                        <Button fx:id="btnGuardar" text="Registrar categoría" onAction="#guardar"/>
                        <Button text="Limpiar campos" onAction="#limpiarFormulario"/>
                    </HBox>
                </VBox>
            </content>
        </TitledPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Categorías registradas" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#actualizarTabla"/>
        </HBox>

        <TableView fx:id="tabla" prefHeight="230">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="420"/>
                <TableColumn fx:id="colDepartamentos" text="Departamentos permitidos" prefWidth="170"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="No hay categorías registradas."/></placeholder>
        </TableView>

        <HBox spacing="10">
            <Button text="Activar / Desactivar seleccionada" onAction="#cambiarEstado"/>
        </HBox>

        <TitledPane text="Departamentos en los que puede trabajar la categoría" expanded="true" collapsible="false">
            <content>
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label fx:id="lblDepartamentos" wrapText="true"
                           text="Selecciona una categoría en la tabla para ver sus departamentos permitidos."/>
                    <ListView fx:id="listaDepartamentos" prefHeight="220" disable="true"/>
                    <HBox spacing="10">
                        <Button text="Guardar departamentos permitidos" onAction="#guardarDepartamentos"/>
                    </HBox>
                </VBox>
            </content>
        </TitledPane>

        <Label fx:id="lblEstado" text=""/>
    </VBox>
</ScrollPane>
