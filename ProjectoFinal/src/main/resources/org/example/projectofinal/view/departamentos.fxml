<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projectofinal.controller.DepartamentosController"
            prefHeight="720" prefWidth="1150">

    <VBox spacing="15"
          AnchorPane.topAnchor="15" AnchorPane.bottomAnchor="15"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label text="Gestión de departamentos"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <TitledPane text="Datos del departamento" expanded="true" collapsible="false">
            <content>
                <VBox spacing="12">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <GridPane hgap="12" vgap="8">
                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Ubicación:" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Correo de contacto:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Teléfono:" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre" promptText="Nombre del departamento"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtUbicacion" promptText="Edificio, piso..."
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtCorreo" promptText="correo@institucion.edu"
                                   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextArea fx:id="txtDescripcion" promptText="Descripción (opcional)"
                                  prefRowCount="2" wrapText="true"
                                  GridPane.columnIndex="0" GridPane.rowIndex="3"
                                  GridPane.columnSpan="4"/>

                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="30" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                    <HBox spacing="10">
                        <Button fx:id="btnGuardar" text="Registrar departamento" onAction="#guardar"/>
                        <Button text="Limpiar campos" onAction="#limpiarFormulario"/>
                    </HBox>
                </VBox>
            </content>
        </TitledPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Departamentos registrados" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#actualizarTabla"/>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="200"/>
                <TableColumn fx:id="colCorreo" text="Correo de contacto" prefWidth="220"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="No hay departamentos registrados."/></placeholder>
        </TableView>

        <HBox spacing="10">
            <Button text="Activar / Desactivar seleccionado" onAction="#cambiarEstado"/>
        </HBox>

        <Label fx:id="lblEstado" text=""/>
    </VBox>
</AnchorPane>
