<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projectofinal.controller.SeguimientosController"
            prefHeight="720" prefWidth="1150">

    <VBox spacing="15"
          AnchorPane.topAnchor="15" AnchorPane.bottomAnchor="15"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label text="Seguimiento de objetivos"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <TitledPane text="Registrar avance" expanded="true" collapsible="false">
            <content>
                <VBox spacing="12">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <GridPane hgap="12" vgap="8">
                        <Label text="Objetivo · Departamento · Período:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Tipo:" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Empleado (solo INDIVIDUAL):" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                        <ComboBox fx:id="cmbAsignacion" promptText="Seleccione asignación" maxWidth="Infinity"
                                  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cmbTipo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cmbEmpleado" promptText="Seleccione empleado" maxWidth="Infinity"
                                  GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                        <Label text="Avance (%):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label text="Fecha:" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <TextField fx:id="txtAvance" promptText="0 a 100" maxWidth="160"
                                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <DatePicker fx:id="dpFecha" maxWidth="Infinity"
                                    GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextArea fx:id="txtObservaciones" promptText="Observaciones (opcional)"
                                  prefRowCount="2" wrapText="true"
                                  GridPane.columnIndex="0" GridPane.rowIndex="5"
                                  GridPane.columnSpan="3"/>

                        <columnConstraints>
                            <ColumnConstraints percentWidth="45" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                    <HBox spacing="10">
                        <Button text="Registrar seguimiento" onAction="#registrar"/>
                        <Button text="Limpiar campos" onAction="#limpiarFormulario"/>
                    </HBox>
                </VBox>
            </content>
        </TitledPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Historial de seguimientos" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#actualizarTodo"/>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="95"/>
                <TableColumn fx:id="colObjetivo" text="Objetivo" prefWidth="200"/>
                <TableColumn fx:id="colPeriodo" text="Período" prefWidth="140"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
                <TableColumn fx:id="colResponsable" text="Empleado / Departamento" prefWidth="190"/>
                <TableColumn fx:id="colAvance" text="Avance" prefWidth="80"/>
                <TableColumn fx:id="colRegistradoPor" text="Registrado por" prefWidth="160"/>
                <TableColumn fx:id="colObservaciones" text="Observaciones" prefWidth="200"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="No hay seguimientos registrados."/></placeholder>
        </TableView>

        <Label fx:id="lblEstado" text=""/>
    </VBox>
</AnchorPane>
