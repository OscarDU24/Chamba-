<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.projectofinal.controller.PeriodosController"
            prefHeight="720" prefWidth="1150">

    <VBox spacing="15"
          AnchorPane.topAnchor="15" AnchorPane.bottomAnchor="15"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label text="Períodos de evaluación"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <TitledPane text="Datos del período" expanded="true" collapsible="false">
            <content>
                <VBox spacing="12">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <GridPane hgap="12" vgap="8">
                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Fecha de inicio:" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Fecha de fin:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label text="Estado:" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre" promptText="Ej. Primer semestre 2027"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <DatePicker fx:id="dpInicio" maxWidth="Infinity"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <DatePicker fx:id="dpFin" maxWidth="Infinity"
                                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cmbEstado" maxWidth="Infinity"
                                  GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextArea fx:id="txtDescripcion" promptText="Descripción (opcional)"
                                  prefRowCount="2" wrapText="true"
                                  GridPane.columnIndex="0" GridPane.rowIndex="3"
                                  GridPane.columnSpan="4"/>

                        <columnConstraints>
                            <ColumnConstraints percentWidth="34" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="22" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="22" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="22" hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>

                    <HBox spacing="10">
                        <Button fx:id="btnGuardar" text="Registrar período" onAction="#guardar"/>
                        <Button text="Limpiar campos" onAction="#limpiarFormulario"/>
                    </HBox>
                </VBox>
            </content>
        </TitledPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Períodos registrados" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#actualizarTabla"/>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colInicio" text="Inicio" prefWidth="110"/>
                <TableColumn fx:id="colFin" text="Fin" prefWidth="110"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="350"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="No hay períodos registrados."/></placeholder>
        </TableView>

        <Label fx:id="lblEstado" text=""/>
    </VBox>
</AnchorPane>
